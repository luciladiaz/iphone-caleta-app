rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Perfil (rol/negocioId/permisos) del usuario autenticado, leído de su propio
    // doc en la colección global de usuarios.
    function perfilAutenticado() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data;
    }

    function esAdminDe(negocioId) {
      return request.auth != null
        && perfilAutenticado().negocioId == negocioId
        && perfilAutenticado().rol == 'admin';
    }

    // Usuario activo de ESTE negocio (admin o no) -- condición base para leer/escribir
    // cualquier cosa dentro de /negocios/{negocioId}/**. Se usa .get(...) con default en
    // vez de acceso directo porque un campo que no existe en el doc (usuarios viejos sin
    // "activo", o sin "permisos") tira error en las reglas -- no da "undefined", deniega
    // TODO el acceso.
    function esDeEsteNegocio(negocioId) {
      return request.auth != null
        && perfilAutenticado().negocioId == negocioId
        && perfilAutenticado().get('activo', true) != false;
    }

    // Admin: acceso total siempre. No-admin: solo si tiene ese módulo tildado en
    // Usuarios.jsx (permisos.{modulo} === true).
    function tienePermiso(negocioId, modulo) {
      return esAdminDe(negocioId) || perfilAutenticado().get('permisos', {})[modulo] == true;
    }

    // Usuarios globales: cada usuario lee su propio doc (para obtener negocioId/permisos
    // al login). La escritura está separada en create/update para dos cosas:
    // 1) que un admin pueda dar de alta al doc de OTRO uid (así se crea un vendedor
    //    desde Usuarios.jsx: antes esto estaba roto, `request.auth.uid == uid` nunca
    //    daba true porque quien escribe es el admin, no el usuario nuevo);
    // 2) que un usuario no-admin NUNCA pueda tocar su propio rol/permisos/negocioId
    //    (si pudiera, se autoescalaría a admin editando su propio doc a mano).
    match /usuarios/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;

      // Alta propia: auto-registro de un negocio nuevo (Registro.jsx) — el usuario
      // recién creado se autoasigna su propio uid como negocioId (nace admin de su
      // propio negocio).
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.data.negocioId == uid;

      // Alta de un compañero de equipo: la hace un admin ya existente del negocio.
      allow create: if esAdminDe(request.resource.data.negocioId);

      // negocioId es inmutable después de creado el doc -- si no, un admin (incluso
      // el admin de su propia cuenta trial recién creada) podría reescribir SU PROPIO
      // negocioId apuntando al de otro negocio: en el momento de la escritura
      // esAdminDe() todavía lee los datos viejos (sigue siendo "admin de mi negocio
      // actual"), así que sin este chequeo la rama no restringía en absoluto a qué
      // valor NUEVO se podía cambiar negocioId -- eso daba acceso de admin total al
      // negocio ajeno vía las reglas de /negocios/{negocioId}/**. Confirmado explotable
      // y corregido 2026-08-30.
      allow update: if (esAdminDe(resource.data.negocioId)
            && request.resource.data.negocioId == resource.data.negocioId)
        || (request.auth != null && request.auth.uid == uid
            && request.resource.data.rol == resource.data.rol
            && request.resource.data.permisos == resource.data.permisos
            && request.resource.data.negocioId == resource.data.negocioId);

      allow delete: if esAdminDe(resource.data.negocioId);
    }

    // Doc principal del negocio: plan, vencePlan, estado, renovacionAutomatica,
    // preapprovalId -- campos de facturación. Antes cualquier usuario activo del negocio
    // podía reescribir esto directo (autoactivarse un plan, revertir su propia
    // suspensión). Ahora: admin siempre; con permiso "config" SOLO nombre/teléfono (lo
    // único que edita Configuracion.jsx acá). Corregido y probado contra el emulador de
    // Firestore 2026-08-30 (ver auditoría QA).
    match /negocios/{negocioId} {
      allow read: if esDeEsteNegocio(negocioId);
      allow write: if esAdminDe(negocioId)
        || (tienePermiso(negocioId, 'config')
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nombre', 'telefono']));
    }

    // El catálogo público (CatalogoPublico.jsx) ya NO lee stock/config directo de acá —
    // llama a api/catalogo.js, que arma la respuesta en el servidor con el Admin SDK
    // (no depende de estas reglas) y devuelve SOLO los campos seguros de los equipos
    // disponibles.
    match /negocios/{negocioId}/publico/info {
      allow read: if true;
      allow write: if esAdminDe(negocioId);
    }

    // Permisos por módulo aplicados a nivel de base de datos (no solo en la pantalla):
    // cada colección exige el permiso del módulo que la gestiona, más las excepciones
    // puntuales que el propio código necesita para funciones que cruzan de un módulo a
    // otro (ej: Ventas también escribe en stock/caja/accesorios/clientes como parte de
    // completar una venta real). Cada mapeo está verificado línea por línea contra el
    // código real y probado contra el emulador de Firestore (35 casos, 2026-08-30) antes
    // de desplegarse -- ver auditoría QA para el detalle de cada colección.

    match /negocios/{negocioId}/config/{doc} {
      allow read: if esDeEsteNegocio(negocioId);
      // checklistReparacion lo actualiza también quien tiene permiso "reparaciones"
      // (ComprobanteReparacion.jsx), no solo "config".
      allow write: if tienePermiso(negocioId, 'config')
        || (tienePermiso(negocioId, 'reparaciones')
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['checklistReparacion']));
    }

    // A partir de acá, "borrar" queda reservado al admin en TODA colección que tenga un
    // botón de borrado real en la pantalla (pedido explícito: un no-admin puede crear/
    // editar según su módulo, pero para borrar algo le tiene que pedir a un admin).
    // "Crear" y "editar" siguen dependiendo del permiso de módulo, como antes -- no se
    // toca eso para no romper flujos ya probados.

    match /negocios/{negocioId}/usuarios/{doc} {
      allow read: if esDeEsteNegocio(negocioId);
      allow create, update: if tienePermiso(negocioId, 'usuarios');
      allow delete: if esAdminDe(negocioId);
    }

    match /negocios/{negocioId}/puntosVenta/{doc} {
      allow read: if esDeEsteNegocio(negocioId);
      allow create, update: if tienePermiso(negocioId, 'config');
      allow delete: if esAdminDe(negocioId);
    }

    match /negocios/{negocioId}/vendedores/{doc} {
      allow read: if esDeEsteNegocio(negocioId);
      allow create, update: if tienePermiso(negocioId, 'config');
      allow delete: if esAdminDe(negocioId);
    }

    match /negocios/{negocioId}/proveedores/{doc} {
      allow read: if esDeEsteNegocio(negocioId);
      allow create, update: if tienePermiso(negocioId, 'config');
      allow delete: if esAdminDe(negocioId);
    }

    match /negocios/{negocioId}/pagosProveedores/{doc} {
      allow read: if esDeEsteNegocio(negocioId);
      allow create, update: if tienePermiso(negocioId, 'proveedores');
      allow delete: if esAdminDe(negocioId);
    }

    match /negocios/{negocioId}/clientes/{doc} {
      allow read: if esDeEsteNegocio(negocioId);
      allow update: if tienePermiso(negocioId, 'clientes');
      allow delete: if esAdminDe(negocioId);
      // Ventas y Reparaciones dan de alta un cliente nuevo al vuelo (selector inline),
      // pero no pueden editar/borrar uno existente sin el permiso de Clientes.
      allow create: if tienePermiso(negocioId, 'clientes')
        || tienePermiso(negocioId, 'ventas')
        || tienePermiso(negocioId, 'reparaciones');
    }

    match /negocios/{negocioId}/reparaciones/{doc} {
      allow read: if esDeEsteNegocio(negocioId);
      allow create, update: if tienePermiso(negocioId, 'reparaciones');
      allow delete: if esAdminDe(negocioId);
    }

    match /negocios/{negocioId}/accesorios/{doc} {
      allow read: if esDeEsteNegocio(negocioId);
      allow create: if tienePermiso(negocioId, 'accesorios');
      allow delete: if esAdminDe(negocioId);
      // Ventas descuenta/repone `cantidad` como efecto de vender/cancelar un accesorio.
      allow update: if tienePermiso(negocioId, 'accesorios')
        || (tienePermiso(negocioId, 'ventas')
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['cantidad']));
    }

    match /negocios/{negocioId}/stock/{doc} {
      allow read: if esDeEsteNegocio(negocioId);
      // Ventas también puede CREAR un equipo nuevo (recibido como parte de pago).
      allow create: if tienePermiso(negocioId, 'stock') || tienePermiso(negocioId, 'ventas');
      allow delete: if esAdminDe(negocioId);
      // Ventas marca "vendido"/"disponible" como parte de una venta real, tocando SOLO
      // el campo estado -- nunca costoUsd ni el resto de la ficha del equipo.
      allow update: if tienePermiso(negocioId, 'stock')
        || (tienePermiso(negocioId, 'ventas')
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estado']));
    }

    match /negocios/{negocioId}/ventas/{doc} {
      allow read: if esDeEsteNegocio(negocioId);
      allow create: if tienePermiso(negocioId, 'ventas');
      allow delete: if esAdminDe(negocioId);
      // Cobros y el Dashboard marcan cuotas pagadas tocando SOLO el campo `cobros`.
      allow update: if tienePermiso(negocioId, 'ventas')
        || ((tienePermiso(negocioId, 'cobros') || tienePermiso(negocioId, 'dashboard'))
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['cobros']));
    }

    // Caja es el destino de los movimientos automáticos de Ventas, Cobros, Reparaciones
    // y Proveedores (una venta, una cuota cobrada, un pago a proveedor) -- restringir
    // el ALTA solo a permiso "caja" rompería esos flujos para cualquier vendedor que
    // tenga uno de esos módulos habilitados pero no "caja" en sí. El borrado manual
    // (el tacho que ve el usuario en Caja.jsx, solo visible en movimientos NO
    // automáticos) sí queda reservado al admin; el borrado automático (que Ventas/
    // Cobros/Reparaciones/Proveedores dispara solo al regenerar un movimiento cuando
    // se edita/cancela algo que el usuario ya tenía permitido) sigue andando igual que
    // antes, distinguido por el campo `automatico` del propio documento que se borra.
    match /negocios/{negocioId}/caja/{doc} {
      allow read: if esDeEsteNegocio(negocioId);
      allow create, update: if tienePermiso(negocioId, 'caja')
        || tienePermiso(negocioId, 'ventas')
        || tienePermiso(negocioId, 'cobros')
        || tienePermiso(negocioId, 'proveedores')
        || tienePermiso(negocioId, 'reparaciones');
      allow delete: if esAdminDe(negocioId)
        || (resource.data.get('automatico', false) == true
            && (tienePermiso(negocioId, 'caja')
                || tienePermiso(negocioId, 'ventas')
                || tienePermiso(negocioId, 'cobros')
                || tienePermiso(negocioId, 'proveedores')
                || tienePermiso(negocioId, 'reparaciones')));
    }

    match /negocios/{negocioId}/cierresCaja/{doc} {
      allow read: if esDeEsteNegocio(negocioId);
      allow write: if tienePermiso(negocioId, 'caja');
    }

    // negocios/{id}/pagos: histórico de pagos de MercadoPago -- lo escribe SOLO el
    // backend (Admin SDK, que no pasa por estas reglas). Sin match acá a propósito: no
    // hace falta que ningún usuario del negocio lo lea desde el cliente, y así queda
    // cerrado por default en vez de abierto por la regla genérica de antes.

    // Suscripciones: solo el admin puede leer, solo servidor puede escribir
    match /suscripciones/{negocioId} {
      allow read: if esDeEsteNegocio(negocioId);
      allow write: if false;
    }
  }
}
