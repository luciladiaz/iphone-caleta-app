rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Perfil (rol/negocioId/permisos) del usuario autenticado, leído de su propio
    // doc en la colección global de usuarios.
    function perfilAutenticado() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data;
    }

    function esAdminDe(negocioId) {
      return request.auth != null
        && perfilAutenticado().negocioId == negocioId
        && perfilAutenticado().rol == 'admin';
    }

    // Usuarios globales: cada usuario lee su propio doc (para obtener negocioId/permisos
    // al login). La escritura está separada en create/update para dos cosas:
    // 1) que un admin pueda dar de alta al doc de OTRO uid (así se crea un vendedor
    //    desde Usuarios.jsx: antes esto estaba roto, `request.auth.uid == uid` nunca
    //    daba true porque quien escribe es el admin, no el usuario nuevo);
    // 2) que un usuario no-admin NUNCA pueda tocar su propio rol/permisos/negocioId
    //    (si pudiera, se autoescalaría a admin editando su propio doc a mano).
    match /usuarios/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;

      // Alta propia: auto-registro de un negocio nuevo (Registro.jsx) — el usuario
      // recién creado se autoasigna su propio uid como negocioId (nace admin de su
      // propio negocio).
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.data.negocioId == uid;

      // Alta de un compañero de equipo: la hace un admin ya existente del negocio.
      allow create: if esAdminDe(request.resource.data.negocioId);

      // negocioId es inmutable después de creado el doc -- si no, un admin (incluso
      // el admin de su propia cuenta trial recién creada) podría reescribir SU PROPIO
      // negocioId apuntando al de otro negocio: en el momento de la escritura
      // esAdminDe() todavía lee los datos viejos (sigue siendo "admin de mi negocio
      // actual"), así que sin este chequeo la rama no restringía en absoluto a qué
      // valor NUEVO se podía cambiar negocioId -- eso daba acceso de admin total al
      // negocio ajeno vía las reglas de /negocios/{negocioId}/**. Confirmado explotable
      // y corregido 2026-08-30.
      allow update: if (esAdminDe(resource.data.negocioId)
            && request.resource.data.negocioId == resource.data.negocioId)
        || (request.auth != null && request.auth.uid == uid
            && request.resource.data.rol == resource.data.rol
            && request.resource.data.permisos == resource.data.permisos
            && request.resource.data.negocioId == resource.data.negocioId);

      allow delete: if esAdminDe(resource.data.negocioId);
    }

    // Negocios: solo acceden usuarios que pertenecen al negocio Y que además
    // estén activos. Si un admin desactiva a alguien desde Usuarios.jsx, esto le
    // corta el acceso de verdad (a nivel base de datos, no solo ocultándole
    // pantallas) — no puede seguir leyendo ni escribiendo nada aunque intente
    // hacerlo por afuera de la app, con la sesión que ya tenía abierta.
    // Ojo: se usa .get('activo', true) y no .activo — acceder a un campo que no
    // existe en el doc tira error en las reglas (no da "undefined", deniega TODO
    // el acceso), así que esto es lo que evita romper a cualquier usuario viejo
    // que nunca tuvo ese campo guardado.
    match /negocios/{negocioId}/{document=**} {
      allow read, write: if request.auth != null
        && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.negocioId == negocioId
        && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.get('activo', true) != false;
    }

    // El catálogo público (CatalogoPublico.jsx) ya NO lee stock/config directo de acá —
    // llama a api/catalogo.js, que arma la respuesta en el servidor con el Admin SDK
    // (no depende de estas reglas) y devuelve SOLO los campos seguros de los equipos
    // disponibles. Antes `stock` tenía "allow read: if true" para esto y exponía a
    // cualquiera en internet, sin login, el costoUsd/IMEI/proveedor de TODOS los
    // equipos (vendidos incluidos) y el nombre/teléfono de clientes que entregaron un
    // equipo como parte de pago — Firestore no permite exponer "algunos campos sí,
    // otros no" de un mismo documento, así que la única forma correcta de tener un
    // catálogo público es armar la respuesta a mano en el servidor, no abrir la
    // colección entera.

    // Info pública del negocio: SOLO nombre, plan y teléfono, en un doc aparte del
    // principal (lo usa api/catalogo.js con el Admin SDK, no depende de esta regla,
    // pero se deja legible por si se necesita consumir directo en el futuro). El doc
    // negocios/{negocioId} en sí (datos de MercadoPago, fechas de vencimiento) NUNCA
    // debe ser público — Firestore no permite exponer "algunos campos sí, otros no" de
    // un mismo documento.
    match /negocios/{negocioId}/publico/info {
      allow read: if true;
    }

    // Suscripciones: solo el admin puede leer, solo servidor puede escribir
    match /suscripciones/{negocioId} {
      allow read: if request.auth != null
        && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.negocioId == negocioId;
      allow write: if false;
    }
  }
}
