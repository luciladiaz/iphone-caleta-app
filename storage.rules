rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Mismo criterio que firestore.rules: solo puede leer/escribir un archivo
    // dentro de negocios/{negocioId}/... quien pertenezca a ese negocio.
    match /negocios/{negocioId}/{allPaths=**} {
      allow read, write: if request.auth != null
        && firestore.get(/databases/(default)/documents/usuarios/$(request.auth.uid)).data.negocioId == negocioId;
    }
  }
}
