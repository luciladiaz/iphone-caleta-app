{
  "crons": [
    {
      "path": "/api/cron-actualizar-dolar",
      "schedule": "0 12 * * *"
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.reventapp.com.ar" }],
      "destination": "https://reventapp.com.ar/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
